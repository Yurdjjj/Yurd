# Приложение
PROJECT_NAME=Yurd
ENVIRONMENT=development
DEBUG=True

# Безопасность и аутентификация
SECRET_KEY=mock-insecure-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# База данных PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/yurd_db

# ИИ провайдер
GEMINI_API_KEY=your-gemini-api-key-here

